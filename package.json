{
  "name": "clipboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "doctor": "node scripts/doctor.mjs",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "typecheck": "vue-tsc --noEmit",
    "cargo-test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check:ipc-contract": "node scripts/check-ipc-contract.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "validate": "npm run lint && npm run typecheck && npm run check:ipc-contract && npm run check:schema && npm run test && npm run clippy && npm run cargo-test"
  },
  "dependencies": {
    "@sketchyicons/vue": "^0.5.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "dompurify": "^3.4.12",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.3.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.10"
  }
}
